# Copia este archivo como ".env" y ajusta los valores. Nunca subas ".env" a Git.

# True en desarrollo, False en producción
DJANGO_DEBUG=True
# Obligatoria cuando DJANGO_DEBUG=False. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-app.onrender.com

# Si no se define, se usa SQLite (db.sqlite3). En producción: PostgreSQL.
# DATABASE_URL=postgresql://usuario:clave@host:5432/mi_mascota

# Datos del negocio que se muestran en la interfaz
NEGOCIO_NOMBRE=Veterinaria Mi Mascota
NEGOCIO_TELEFONO=2222-3333
NEGOCIO_DIRECCION=Ciudad de Guatemala
HORARIO_APERTURA=8
HORARIO_CIERRE=17

# Para crear el administrador automáticamente al desplegar (comando crear_admin)
# DJANGO_ADMIN_USER=admin
# DJANGO_ADMIN_PASSWORD=
# DJANGO_ADMIN_EMAIL=admin@example.com
